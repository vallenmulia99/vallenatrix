#!/usr/bin/env bash
set -euo pipefail

# Resolve script path even if symlinked
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

MAIN_BUILD="$REPO_ROOT/vallenterminal/out/main/index.js"
PACKAGE_JSON="$REPO_ROOT/package.json"

VERSION="0.1.0"
if [ -f "$PACKAGE_JSON" ]; then
  VERSION=$(grep '"version"' "$PACKAGE_JSON" | head -n 1 | sed -E 's/.*"version": "([^"]+)".*/\1/')
fi

show_help() {
  cat << EOF
Vallenatrix - Terminal transparan kustom dengan anime / media background

Penggunaan:
  vallenatrix [opsi]

Opsi:
  --foreground, -f    Jalankan terminal di foreground (tampilkan log ke stdout/stderr)
  --version, -v       Tampilkan versi vallenatrix
  --help, -h          Tampilkan bantuan ini

Contoh:
  vallenatrix               # Jalankan di background (lepas dari shell)
  vallenatrix --foreground  # Jalankan di foreground untuk debugging
EOF
}

FOREGROUND=0

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      show_help
      exit 0
      ;;
    --version|-v|-versi|--versi)
      echo "vallenatrix v$VERSION"
      exit 0
      ;;
    --foreground|-f)
      FOREGROUND=1
      ;;
    *)
      echo "Opsi tidak dikenal: $arg"
      echo "Jalankan 'vallenatrix --help' untuk melihat daftar opsi."
      exit 1
      ;;
  esac
done

# Check build artifact
if [ ! -f "$MAIN_BUILD" ]; then
  echo "Error: Vallenatrix belum di-build atau file build tidak ditemukan."
  echo "Silakan jalankan installer terlebih dahulu:"
  echo "  cd \"$REPO_ROOT\" && ./install.sh"
  exit 1
fi

ELECTRON_BIN="$REPO_ROOT/node_modules/.bin/electron"
if [ ! -x "$ELECTRON_BIN" ]; then
  ELECTRON_BIN="$REPO_ROOT/vallenterminal/node_modules/.bin/electron"
fi

if [ ! -x "$ELECTRON_BIN" ]; then
  echo "Error: Binary Electron tidak ditemukan di node_modules."
  echo "Silakan jalankan './install.sh' di root repo untuk menginstal dependensi."
  exit 1
fi

export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-i965}"

if [ "$FOREGROUND" -eq 1 ]; then
  exec "$ELECTRON_BIN" "$MAIN_BUILD"
else
  CALLER_WIN="${WINDOWID:-}"
  if [ -z "$CALLER_WIN" ] && command -v xdotool >/dev/null 2>&1; then
    CALLER_WIN=$(xdotool getactivewindow 2>/dev/null || true)
  fi

  # Start Electron completely detached in a new session (setsid)
  setsid "$ELECTRON_BIN" "$MAIN_BUILD" </dev/null >/dev/null 2>&1 &

  printf "Loading Vallenatrix: "
  for i in 1 2 3 4 5; do
    printf "%d " "$i"
    sleep 0.18
  done
  printf "Done!\n"
  sleep 0.2

  # Close caller terminal window
  if [ -n "$CALLER_WIN" ]; then
    xdotool windowclose "$CALLER_WIN" 2>/dev/null || true
  fi
  kill -9 "$PPID" 2>/dev/null || true
  exit 0
fi
